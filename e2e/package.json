{
  "name": "e2e-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "image:build": "bash scripts/build-e2e-image.sh",
    "compose:up": "docker compose -f compose.e2e.yaml up -d --wait --wait-timeout 240",
    "compose:down": "docker compose -f compose.e2e.yaml down -v --remove-orphans",
    "compose:webserver": "npm run image:build && npm run compose:up && node scripts/hold-compose-open.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "show-trace": "playwright show-trace"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
