# Skills Hub — repo root .gitignore
# (backend/ and frontend/ have their own .gitignore for build artifacts)

# S020/S204: verification logs live at repo root so './gradlew clean' will not delete them mid-run.
verify-all.log
verify-pr.log
verify-release.log
scheduled_tasks.lock

.vscode/

# vite cache 殘留（若不小心從 root cwd 跑 vite 會建空 .vite cache）
node_modules/
docs/grimo/handovers/HANDOVER.md
temp/
.DS_Store

# S099c: cross-validate script clone cache
.cross-validate-cache/

# S099d: quality audit report (commit snapshot manually)
docs/grimo/quality-audit-report.md

# Git worktrees（per using-git-worktrees skill；路徑 policy: .worktrees/，避開 .claude/worktrees/）
.worktrees/
poc/

# Local agent instructions/runtime artifacts
.agents/
